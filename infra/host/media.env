# Environment of the service when it runs on your machine (make host SVC=media). Same names as the compose service,
# the in-network hostnames replaced by localhost and the host ports published by docker-compose.yml.
# Passwords and secrets are the defaults of infra/.env.example: change them here if you changed them there.
# Load it in the IDE run configuration (IntelliJ: EnvFile plugin / "Environment variables"; VS Code: "envFile";
# shell: set -a; . infra/host/media.env; set +a).
APP_PROFILE=local
LOG_LEVEL=info
OIDC_ISSUER_URI=http://localhost:8180/realms/wallpaperhub
OIDC_JWKS_URI=http://localhost:8180/realms/wallpaperhub/protocol/openid-connect/certs
OIDC_TOKEN_URI=http://localhost:8180/realms/wallpaperhub/protocol/openid-connect/token
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_METRIC_EXPORT_INTERVAL=15000
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local
OTEL_SERVICE_NAME=media-service
HTTP_PORT=8102
MGMT_PORT=8192
DB_HOST=localhost
DB_PORT=5433
DB_NAME=media
DB_USER=media
DB_PASSWORD=media
REDIS_HOST=localhost
REDIS_PORT=6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_PATH_STYLE=true
S3_ACCESS_KEY=media-svc
S3_SECRET_KEY=media-svc-secret
S3_BUCKET_ORIGINALS=wallpaperhub-originals
S3_BUCKET_PUBLIC=wallpaperhub-media
S3_PUBLIC_BASE_URL=http://localhost:9000/wallpaperhub-media
OIDC_CLIENT_ID=media-svc
OIDC_CLIENT_SECRET=media-svc-dev-secret
