# Environment of the service when it runs on your machine (make host SVC=account). Same names as the compose service,
# the in-network hostnames replaced by localhost and the host ports published by docker-compose.yml.
# Passwords and secrets are the defaults of infra/.env.example: change them here if you changed them there.
# Load it in the IDE run configuration (IntelliJ: EnvFile plugin / "Environment variables"; VS Code: "envFile";
# shell: set -a; . infra/host/account.env; set +a).
APP_PROFILE=local
LOG_LEVEL=info
OIDC_ISSUER_URI=http://localhost:8180/realms/wallpaperhub
OIDC_JWKS_URI=http://localhost:8180/realms/wallpaperhub/protocol/openid-connect/certs
OIDC_TOKEN_URI=http://localhost:8180/realms/wallpaperhub/protocol/openid-connect/token
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_METRIC_EXPORT_INTERVAL=15000
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local
OTEL_SERVICE_NAME=account-service
HTTP_PORT=8101
GRPC_PORT=9101
MGMT_PORT=8191
DB_HOST=localhost
DB_PORT=5432
DB_NAME=account
DB_USER=account
DB_PASSWORD=account
REDIS_HOST=localhost
REDIS_PORT=6379
KEYCLOAK_BASE_URL=http://localhost:8180
KEYCLOAK_REALM=wallpaperhub
MEDIA_BASE_URL=http://localhost:8102
OIDC_CLIENT_ID=account-svc
OIDC_CLIENT_SECRET=account-svc-dev-secret
OUTBOX_RELAY_ENABLED=true
