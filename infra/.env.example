# Copy to infra/.env. Every value below is also the built-in default, so the file is optional.
# Local development only: do not reuse these secrets anywhere else.

# Profiles started by a plain "docker compose up -d" (only needed when you call docker compose yourself; the Makefile
# passes --profile flags explicitly, and flags win over this variable - leave it commented when you use make)
# COMPOSE_PROFILES=infra,observability

# Which implementation of each service to build for the "apps" profile
ACCOUNT_DIR=../services/account/java-spring
MEDIA_DIR=../services/media/java-spring
CATALOG_DIR=../services/catalog/java-spring
NOTIFICATION_DIR=../services/notification/java-spring
GATEWAY_DIR=../services/gateway/envoy

LOG_LEVEL=info

# Databases
PG_ACCOUNT_PASSWORD=account
PG_MEDIA_PASSWORD=media
PG_KEYCLOAK_PASSWORD=keycloak
MONGO_PASSWORD=root

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
ACCOUNT_SVC_SECRET=account-svc-dev-secret
MEDIA_SVC_SECRET=media-svc-dev-secret
CATALOG_SVC_SECRET=catalog-svc-dev-secret
NOTIFICATION_SVC_SECRET=notification-svc-dev-secret
GATEWAY_SVC_SECRET=gateway-svc-dev-secret

# S3 (Silo). Root credentials are only used by s3-init and the web console.
S3_ROOT_USER=silo-admin
S3_ROOT_PASSWORD=silo-admin-secret
S3_BUCKET_ORIGINALS=wallpaperhub-originals
S3_BUCKET_PUBLIC=wallpaperhub-media
S3_ACCESS_KEY=media-svc
S3_SECRET_KEY=media-svc-secret

# Host side of the published ports. Everything binds to loopback only; 0.0.0.0 would expose the stack to your LAN.
# BIND_ADDRESS=127.0.0.1
# Override a port when "make doctor" reports a conflict or a Windows excluded range (Hyper-V/WSL reserve blocks of ports):
# PORT_GATEWAY=8080
# PORT_KEYCLOAK=8180
# PORT_POSTGRES_ACCOUNT=5432
# PORT_POSTGRES_MEDIA=5433
# PORT_MONGO=27017
# PORT_REDIS=6379
# PORT_REDIS_NOTIFICATION=6380
# PORT_KAFKA=9092
# PORT_SCHEMA_REGISTRY=8081
# PORT_ELASTICSEARCH=9200
# PORT_S3_API=9000
# PORT_S3_CONSOLE=9001
# PORT_MAILPIT_UI=8025
# PORT_MAILPIT_SMTP=1025
# PORT_GRAFANA=3000
# PORT_PROMETHEUS=9090
# PORT_LOKI=3100
# PORT_TEMPO=3200
# PORT_ALLOY_UI=12345
# PORT_ALLOY_OTLP_GRPC=4317
# PORT_ALLOY_OTLP_HTTP=4318
# Web UIs (profile tools, make up-tools)
# PORT_KAFKA_UI=8082
# PORT_ADMINER=8083
# PORT_MONGO_UI=8084
# TOOLS_READONLY=false     # true: Kafka UI and Mongoku refuse writes
# KAFKA_UI_IMAGE=ghcr.io/kafbat/kafka-ui:v1.5.0
# ADMINER_IMAGE=adminer:5.5.1
# MONGO_UI_IMAGE=huggingface/mongoku:2.11.5
# Services (apps profile): PORT_<ACCOUNT|MEDIA|CATALOG|NOTIFICATION>_HTTP / _MGMT, PORT_ACCOUNT_GRPC, PORT_GATEWAY_MGMT
