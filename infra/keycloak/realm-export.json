{
  "realm": "wallpaperhub",
  "displayName": "Wallpaper Hub",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "verifyEmail": false,
  "passwordPolicy": "length(8) and notUsername",
  "accessTokenLifespan": 300,
  "accessCodeLifespan": 60,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": false,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "en",
    "de",
    "es"
  ],
  "defaultLocale": "en",
  "eventsEnabled": true,
  "eventsListeners": [
    "jboss-logging"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@wallpaperhub.local",
    "fromDisplayName": "Wallpaper Hub",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "defaultRole": {
    "name": "default-roles-wallpaperhub",
    "description": "${role_default-roles}",
    "composite": true,
    "clientRole": false
  },
  "roles": {
    "realm": [
      {
        "name": "USER",
        "description": "Regular user",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "MODERATOR",
        "description": "Can moderate wallpapers (includes USER)",
        "composite": true,
        "composites": {
          "realm": [
            "USER"
          ]
        },
        "clientRole": false
      },
      {
        "name": "ADMIN",
        "description": "Administrator (includes MODERATOR and USER)",
        "composite": true,
        "composites": {
          "realm": [
            "MODERATOR"
          ]
        },
        "clientRole": false
      },
      {
        "name": "internal",
        "description": "Held by service accounts; guards internal-only endpoints",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "offline_access",
        "description": "${role_offline-access}",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "default-roles-wallpaperhub",
        "description": "${role_default-roles}",
        "composite": true,
        "composites": {
          "realm": [
            "offline_access",
            "uma_authorization"
          ],
          "client": {
            "account": [
              "view-profile",
              "manage-account"
            ]
          }
        },
        "clientRole": false
      }
    ]
  },
  "clients": [
    {
      "clientId": "web-spa",
      "name": "Wallpaper Hub SPA",
      "description": "End-user login: authorization code + PKCE (S256), no client secret",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "bearerOnly": false,
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "aud-account-svc",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "account-svc",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        },
        {
          "name": "aud-media-svc",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "media-svc",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        },
        {
          "name": "aud-catalog-svc",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "catalog-svc",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        },
        {
          "name": "aud-notification-svc",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "notification-svc",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        }
      ],
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:4200/*",
        "http://localhost:8080/*",
        "https://localhost:5173/*",
        "https://localhost:4200/*",
        "https://localhost:8443/*"
      ],
      "webOrigins": [
        "+"
      ],
      "frontchannelLogout": true,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      }
    },
    {
      "clientId": "e2e-tests",
      "name": "End-to-end tests",
      "description": "DEV/TEST ONLY: password grant for the e2e suite. Delete outside local development.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "bearerOnly": false,
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "aud-account-svc",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "account-svc",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        },
        {
          "name": "aud-media-svc",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "media-svc",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        },
        {
          "name": "aud-catalog-svc",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "catalog-svc",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        },
        {
          "name": "aud-notification-svc",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "notification-svc",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "account-svc",
      "name": "account-service",
      "description": "Calls the Keycloak admin API to create users (see realm-management roles on its service account)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${ACCOUNT_SVC_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "bearerOnly": false,
      "fullScopeAllowed": true,
      "protocolMappers": []
    },
    {
      "clientId": "media-svc",
      "name": "media-service",
      "description": "Service-to-service calls",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${MEDIA_SVC_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "bearerOnly": false,
      "fullScopeAllowed": true,
      "protocolMappers": []
    },
    {
      "clientId": "catalog-svc",
      "name": "catalog-service",
      "description": "Calls media-service (REST) and account-service (gRPC)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${CATALOG_SVC_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "bearerOnly": false,
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "aud-media-svc",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "media-svc",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        },
        {
          "name": "aud-account-svc",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "account-svc",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "notification-svc",
      "name": "notification-service",
      "description": "Calls account-service (gRPC) and catalog-service (REST)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${NOTIFICATION_SVC_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "bearerOnly": false,
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "aud-account-svc",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "account-svc",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        },
        {
          "name": "aud-catalog-svc",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "catalog-svc",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "gateway",
      "name": "api-gateway",
      "description": "Optional: gateway-originated calls",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${GATEWAY_SVC_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "bearerOnly": false,
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "aud-account-svc",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "account-svc",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        },
        {
          "name": "aud-media-svc",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "media-svc",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        },
        {
          "name": "aud-catalog-svc",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "catalog-svc",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        },
        {
          "name": "aud-notification-svc",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "notification-svc",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "00000000-0000-4000-8000-000000000001",
      "username": "alice",
      "email": "alice@wallpaperhub.local",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Example",
      "enabled": true,
      "attributes": {
        "locale": [
          "en"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-wallpaperhub",
        "USER"
      ]
    },
    {
      "id": "00000000-0000-4000-8000-000000000002",
      "username": "mod",
      "email": "mod@wallpaperhub.local",
      "emailVerified": true,
      "firstName": "Mona",
      "lastName": "Moderator",
      "enabled": true,
      "attributes": {
        "locale": [
          "de"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-wallpaperhub",
        "MODERATOR"
      ]
    },
    {
      "id": "00000000-0000-4000-8000-000000000003",
      "username": "admin",
      "email": "admin@wallpaperhub.local",
      "emailVerified": true,
      "firstName": "Adam",
      "lastName": "Admin",
      "enabled": true,
      "attributes": {
        "locale": [
          "es"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-wallpaperhub",
        "ADMIN"
      ]
    },
    {
      "username": "service-account-account-svc",
      "enabled": true,
      "serviceAccountClientId": "account-svc",
      "realmRoles": [
        "default-roles-wallpaperhub",
        "internal"
      ],
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users",
          "view-realm"
        ]
      }
    },
    {
      "username": "service-account-media-svc",
      "enabled": true,
      "serviceAccountClientId": "media-svc",
      "realmRoles": [
        "default-roles-wallpaperhub",
        "internal"
      ]
    },
    {
      "username": "service-account-catalog-svc",
      "enabled": true,
      "serviceAccountClientId": "catalog-svc",
      "realmRoles": [
        "default-roles-wallpaperhub",
        "internal"
      ]
    },
    {
      "username": "service-account-notification-svc",
      "enabled": true,
      "serviceAccountClientId": "notification-svc",
      "realmRoles": [
        "default-roles-wallpaperhub",
        "internal"
      ]
    },
    {
      "username": "service-account-gateway",
      "enabled": true,
      "serviceAccountClientId": "gateway",
      "realmRoles": [
        "default-roles-wallpaperhub",
        "internal"
      ]
    }
  ]
