# Everything that is mounted into a Linux container or run by make must keep LF endings, whatever core.autocrlf says.
* text=auto
*.sh      text eol=lf
*.alloy   text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.hurl    text eol=lf
*.js      text eol=lf
*.py      text eol=lf
*.sql     text eol=lf
*.proto   text eol=lf
*.avsc    text eol=lf
*.graphql text eol=lf
*.env     text eol=lf
Makefile  text eol=lf
Dockerfile text eol=lf
*.png     binary
