# Per-service parameters of the conformance suite (read by run.sh; defaults are the host ports of docker-compose.yml)
OTEL_NAME=account-service
API_URL_DEFAULT=http://localhost:8101
MGMT_URL_DEFAULT=http://localhost:8191
LOG_CONTAINER_DEFAULT=wallpaperhub-account-1
BAD_AUD_CLIENT=media-svc          # a service token that does not carry the audience account-svc
PROTECTED_PATH=/api/v1/users/me   # GET, answers 200 for alice
LIST_PATH=/api/v1/users           # GET with ?page&size
LIST_USER=admin                   # who may call it
VALIDATION=json
VALIDATION_PATH=/api/v1/registrations   # POST, an empty body must be refused with validation-failed
VALIDATION_USER=alice
