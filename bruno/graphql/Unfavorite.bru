meta {
  name: Unfavorite
  type: graphql
  seq: 2
  tags: [
    authenticated
    write
  ]
}

post {
  url: {{baseUrl}}/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  mutation Unfavorite($id: ID!) {
    unfavoriteWallpaper(id: $id) {
      id
      favoriteCount
      favoritedByMe
    }
  }
}

body:graphql:vars {
  {
    "id": "{{wallpaperId}}"
  }
}

assert {
  res.status: eq 200
  res.body.errors: isUndefined
}

docs {
  Mutation `Unfavorite` from contracts/graphql/examples/favorite.graphql.

  GraphQL answers 200 even for errors, so the assertion also checks that `errors` is absent.
}
