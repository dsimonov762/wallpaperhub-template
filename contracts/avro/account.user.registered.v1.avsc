{
  "type": "record",
  "name": "UserRegistered",
  "namespace": "dev.wallpaperhub.account.v1",
  "doc": "A user registered. Notification sends the welcome e-mail in the language of locale. Contains the e-mail address (PII): consumers must not log it.",
  "fields": [
    { "name": "eventId",     "type": "string" },
    { "name": "userId",      "type": "string" },
    { "name": "username",    "type": "string" },
    { "name": "email",       "type": "string" },
    { "name": "locale",      "type": "string", "default": "en" },
    { "name": "occurredAt",  "type": { "type": "long", "logicalType": "timestamp-millis" } }
  ]
}
