# Avatar and banner: account-service verifies the asset with media-service before it writes anything (README 4.2).
# SYSTEM TEST: needs real account + media services. mod uploads and owns the picture, alice tries to use it.
# Variables: base_url, alice_token, mod_token, upload_png2 (a second unique picture, generated by run.sh)

POST {{base_url}}/api/v1/media
Authorization: Bearer {{mod_token}}
[MultipartFormData]
purpose: AVATAR
file: file,{{upload_png2}}; image/png
HTTP 202
[Captures]
mod_avatar_id: jsonpath "$.assetId"

GET {{base_url}}/api/v1/media/{{mod_avatar_id}}
Authorization: Bearer {{mod_token}}
[Options]
retry: 30
retry-interval: 2s
HTTP 200
[Asserts]
jsonpath "$.status" == "READY"

# The owner can use it
PUT {{base_url}}/api/v1/users/me/avatar
Authorization: Bearer {{mod_token}}
Content-Type: application/json
{ "assetId": "{{mod_avatar_id}}" }
HTTP 200
[Asserts]
jsonpath "$.avatarAssetId" == {{mod_avatar_id}}
jsonpath "$.avatarUrl" isString

# Someone else cannot: 403 with the media error code, and alice's profile is untouched
PUT {{base_url}}/api/v1/users/me/avatar
Authorization: Bearer {{alice_token}}
Content-Type: application/json
{ "assetId": "{{mod_avatar_id}}" }
HTTP 403
[Asserts]
jsonpath "$.code" == "media.asset-not-owned"

PUT {{base_url}}/api/v1/users/me/banner
Authorization: Bearer {{alice_token}}
Content-Type: application/json
{ "assetId": "{{mod_avatar_id}}" }
HTTP 403
[Asserts]
jsonpath "$.code" == "media.asset-not-owned"

# An id that does not exist: 404
PUT {{base_url}}/api/v1/users/me/avatar
Authorization: Bearer {{alice_token}}
Content-Type: application/json
{ "assetId": "ast_00000000000000000000000000" }
HTTP 404
[Asserts]
jsonpath "$.code" == "media.asset-not-found"

# The owner's own asset with the wrong purpose for the banner: 409
PUT {{base_url}}/api/v1/users/me/banner
Authorization: Bearer {{mod_token}}
Content-Type: application/json
{ "assetId": "{{mod_avatar_id}}" }
HTTP 409
[Asserts]
jsonpath "$.code" == "media.asset-purpose-mismatch"
