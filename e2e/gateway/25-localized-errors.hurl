# Errors generated by the gateway use the texts of contracts/i18n, in the language of Accept-Language (first tag), English otherwise.
GET {{base_url}}/api/v1/users/me
Accept-Language: de-DE,de;q=0.9,en;q=0.8
HTTP 401
[Asserts]
header "Content-Language" == "de"
jsonpath "$.title" == "Nicht authentifiziert"
jsonpath "$.type" == "https://wallpaperhub.dev/problems/unauthorized"

GET {{base_url}}/api/v1/users/me
Accept-Language: es
HTTP 401
[Asserts]
header "Content-Language" == "es"
jsonpath "$.title" == "No autenticado"

# Unsupported language or the supported one only second: English
GET {{base_url}}/api/v1/users/me
Accept-Language: fr, de;q=0.8
HTTP 401
[Asserts]
header "Content-Language" == "en"
jsonpath "$.title" == "Unauthorized"

GET {{base_url}}/api/v1/users/me
HTTP 401
[Asserts]
header "Content-Language" == "en"
